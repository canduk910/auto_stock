# KIS OpenAPI 인증
KIS_APP_KEY_REAL=your_app_key_here
KIS_APP_SECRET_REAL=your_app_secret_here
KIS_ACCOUNT_NO_REAL=12345678
KIS_ACCOUNT_PRODUCT_REAL=01
KIS_HTS_ID_REAL=your_hts_id    # 실전 체결통보(H0STCNI0) 구독에 필요

KIS_APP_KEY_VTS=your_app_key_here
KIS_APP_SECRET_VTS=your_app_secret_here
KIS_ACCOUNT_NO_VTS=12345678
KIS_ACCOUNT_PRODUCT_VTS=01

# 환경 설정: vts(모의) 또는 real(실전)
KIS_ENV=vts

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# RDS(PostgreSQL) — Supabase→RDS 이전 단계 0 (asyncpg 인프라, 사이클 M0)
# 아직 어느 db 모듈도 사용하지 않음 (supabase.py 병존). asyncpg DSN 형식.
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# 서버
HOST=0.0.0.0
PORT=8000
AUTO_START=false           # true: 서버 기동 시 자동 매매 시작

# --- API 인증 (cycle243) ---
# 미설정이면 **fail-closed**: /health 를 뺀 전 경로 401 + 기동 시 [api_auth_key_missing] CRITICAL.
# 값은 절대 커밋하지 않는다(개발용 기본키 = 공격자가 프로덕션에 가장 먼저 시도할 값).
# 생성: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
# 운영에서 이 값은 nginx 가 프록시 요청에 주입한다(브라우저 미노출).
API_AUTH_KEY=
# 교차 출처 허용 목록(CSV). 빈 값 = same-origin 전용 — **prod 는 비워 둔다**.
# dev 는 비워도 동작한다(vite proxy 가 Origin 을 upstream 으로 정규화한다 —
# frontend/vite.config.ts). 그 경로를 쓰지 않는 별도 프런트를 붙일 때만 여기에
# `http://localhost:3000` 처럼 **명시 열거**한다.
# ⚠️ `*` 는 무시된다(기동 시 [api_auth_wildcard_origin] WARNING) — 와일드카드는
# CORS credentialed preflight 를 전 오리진에 열고 CSRF Origin 검사까지 무력화한다.
API_ALLOWED_ORIGINS=
# 리포터 스코프 키(cycle249). GET/HEAD 전체 + `POST /api/log-reports/{date}/external`
# 단 한 경로만 허용된다. nginx `map $remote_user` 가 Basic 사용자 `reporter` 에게만
# 이 값을 주입한다(운영 키와 달라야 판정이 성립). 값을 적어 두지 않는다 — 이름만
# 남겨 존재를 알리고 채우는 것은 배포 절차의 몫이다. 빈 값 = 리포터 역할 비활성.
API_REPORTER_KEY=

# OpenAI 파라미터 추천
OPENAI_API_KEY=
OPENAI_RECOMMEND_MODEL=gpt-5.6-luna

# --- 외부 백테스트 서버 (MCP, 선택) ---
# auto_stock EC2 에서 외부 백테스트 서버 호출 시 사용
# 운영: http://43.202.187.5:3846/mcp / 로컬: http://127.0.0.1:3846/mcp
# KIS_MCP_ENABLED=true 일 때만 실제 호출. false(기본) 면 graceful degrade.
KIS_MCP_URL=http://43.202.187.5:3846/mcp
KIS_MCP_ENABLED=false
BACKTEST_TIMEOUT_SECS=300

# --- 외부 매크로 (dkstock.cloud, 시장 레짐 필터, 사이클 2) ---
# 봇 계정: autostock / AUTOSTOCK1 (대문자 필수)
# DKSTOCK_REGIME_ENABLED=true 일 때만 _boot 매크로 fetch + 매수 가드 활성
# false (기본) 면 외부 호출 0건, 매수 가드 비활성, cash_usage_ratio 자동 갱신 비활성
DKSTOCK_API_URL=https://dkstock.cloud
DKSTOCK_USERNAME=autostock
DKSTOCK_PASSWORD=AUTOSTOCK1
DKSTOCK_REGIME_ENABLED=false

# --- 매크로 API (macro_lite, cycle303, 매매와 무관한 별도 컨테이너) ---
# FRED JSON API 폴백 키 — fredgraph.csv 무키 경로가 실패(HTML 차단/timeout)할 때만
# 쓰인다. 없어도 7일 stale 캐시까지는 동작한다. 발급: https://fred.stlouisfed.org/docs/api/api_key.html
# docker-compose.prod.yml/docker-compose.yml 의 macro 서비스 environment 가 이 값
# 하나만 전달한다(macro 는 env_file: .env 를 쓰지 않는다 — docs/macro-lite.md 참조).
FRED_API_KEY=
