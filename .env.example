# KIS OpenAPI 인증
KIS_APP_KEY_REAL=your_app_key_here
KIS_APP_SECRET_REAL=your_app_secret_here
KIS_ACCOUNT_NO_REAL=12345678
KIS_ACCOUNT_PRODUCT_REAL=01
KIS_HTS_ID_REAL=your_hts_id    # 실전 체결통보(H0STCNI0) 구독에 필요

KIS_APP_KEY_VTS=your_app_key_here
KIS_APP_SECRET_VTS=your_app_secret_here
KIS_ACCOUNT_NO_VTS=12345678
KIS_ACCOUNT_PRODUCT_VTS=01

# 환경 설정: vts(모의) 또는 real(실전)
KIS_ENV=vts

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# RDS(PostgreSQL) — Supabase→RDS 이전 단계 0 (asyncpg 인프라, 사이클 M0)
# 아직 어느 db 모듈도 사용하지 않음 (supabase.py 병존). asyncpg DSN 형식.
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# 서버
HOST=0.0.0.0
PORT=8000
AUTO_START=false           # true: 서버 기동 시 자동 매매 시작

# OpenAI 파라미터 추천
OPENAI_API_KEY=
OPENAI_RECOMMEND_MODEL=gpt-5.4-mini-2026-03-17

# --- 외부 백테스트 서버 (MCP, 선택) ---
# auto_stock EC2 에서 외부 백테스트 서버 호출 시 사용
# 운영: http://43.202.187.5:3846/mcp / 로컬: http://127.0.0.1:3846/mcp
# KIS_MCP_ENABLED=true 일 때만 실제 호출. false(기본) 면 graceful degrade.
KIS_MCP_URL=http://43.202.187.5:3846/mcp
KIS_MCP_ENABLED=false
BACKTEST_TIMEOUT_SECS=300

# --- 외부 매크로 (dkstock.cloud, 시장 레짐 필터, 사이클 2) ---
# 봇 계정: autostock / AUTOSTOCK1 (대문자 필수)
# DKSTOCK_REGIME_ENABLED=true 일 때만 _boot 매크로 fetch + 매수 가드 활성
# false (기본) 면 외부 호출 0건, 매수 가드 비활성, cash_usage_ratio 자동 갱신 비활성
DKSTOCK_API_URL=https://dkstock.cloud
DKSTOCK_USERNAME=autostock
DKSTOCK_PASSWORD=AUTOSTOCK1
DKSTOCK_REGIME_ENABLED=false
