# cycle243 — nginx 설정 **템플릿**(envsubst). `nginx:alpine` 공식 엔트리포인트가
# `/etc/nginx/templates/*.template` 을 `/etc/nginx/conf.d/` 로 렌더한다.
#   * 파일명이 `default.conf.template` 이어야 스톡 `default.conf` 를 덮어쓴다.
#     (다른 이름이면 스톡 server 블록이 80 에 공존한다 — Dockerfile 의 COPY 대상 확인)
#   * `NGINX_ENVSUBST_FILTER=^API_(AUTH|REPORTER)_KEY$` 로 치환 대상을 **두 개**로
#     제한한다(cycle249 — 리포터 스코프 키 추가). 제한하지 않으면 `.env` 에 같은
#     접두 변수가 생겼을 때 프록시 헤더가 오염되고, 다른 비밀이 설정 파일로 샐 수 있다.
#   * `.htpasswd` 는 git 에 커밋하지 않는다. 호스트 `./secrets/` 를 읽기전용 마운트.
#     `auth_basic_user_file` 은 파싱 시점이 아니라 **요청 시점**에 파일을 여므로 nginx 는
#     어떤 결손 상태에서도 정상 기동한다. 증상은 **세 갈래**다(실측, nginx 1.31.5-alpine):
#       - 무자격 요청 → **401** (파일이 정상일 때와 똑같다 = 결손을 무자격 curl 로는
#         절대 판별할 수 없다. 검증은 반드시 `-u` 자격을 넣고 한다)
#       - 자격 요청 + 파일 **부재**(ENOENT) → **403**, 로그 `... failed (2: No such file...)`
#       - 자격 요청 + **권한 거부**(EACCES) → **500**, 로그 `[crit] ... (13: Permission denied)`
#     ⚠️ 권한: nginx **worker 는 컨테이너 안에서 uid 101(nginx)** 이고 호스트 파일은
#     `ubuntu`(uid 1000) 소유다. `chmod 600` 이나 디렉터리 `chmod 700` 으로 두면 worker 가
#     열지도 traverse 하지도 못해 **전면 500** 이다(`.token_cache` root 소유 사고와 동일
#     계열). 호스트에서 `chmod 755 secrets && chmod 644 secrets/.htpasswd` — 파일 내용은
#     apr1 **해시**뿐이고 호스트 접근은 이미 SSH 로 제한된다.
#   * `API_AUTH_KEY` 환경변수가 **아예 없으면** envsubst 가 치환하지 않아 nginx 가
#     `[emerg] unknown "api_auth_key" variable` 로 **기동 실패**한다(빈 값과 증상이 정반대).
#     compose 의 frontend `environment:` 에 있는 API_AUTH_KEY 전달 줄이 항상 변수를
#     정의하므로 그 줄을 지우지 마라 — 빈 값이면 `X-API-Key ""` 로 렌더돼 헤더가
#     전달되지 않는다. `API_REPORTER_KEY` 도 같은 원리로 항상 정의돼 있어야 하고,
#     미설정이면 envsubst 가 빈 문자열을 넣어 `reporter` 사용자가 빈 키를 받는다
#     (의도 — 백엔드가 fail-closed 로 401 한다).
#   * 🔴 **이 파일에서 치환 구문(달러+중괄호 형태)은 아래 `map` 블록의 `default`/
#     `reporter` 두 줄에만 쓴다.** envsubst 는 주석을 구분하지 않으므로 설명문에 그
#     구문을 적으면 **렌더된 설정 주석에 키가 평문으로 박힌다**(cycle246 실측: 렌더
#     결과에 키 2회 등장, 운영 중 설정 덤프로 유출). 설명에는 변수 이름만 백틱으로 쓴다.
#     회귀 가드 = `tests/unit/ast/test_cycle246_nginx_template_no_key_leak.py`.
#
# cycle249 — Basic 사용자별 X-API-Key 선택. `location /api/` 는 클라이언트가 보낸
# X-API-Key 를 **치환**하므로(cycle243) "루틴이 스코프 키를 보낸다" 는 설계는 성립
# 하지 않는다 — 스코프의 출발점은 nginx Basic 사용자다. `reporter` 사용자(계약된
# 이름 — htpasswd 등록 시 이 이름을 쓴다)에게만 리포터 키를 주입하고, 그 외
# (`default`)는 종전대로 운영 키를 받는다. `map` 은 **http 컨텍스트**(server 블록
# 밖·앞)에서만 유효하다 — server 블록 안에 두면 nginx 가 기동을 거부한다.
# ⚠️ default/reporter 를 뒤바꾸면 리포터 사용자가 운영 키를 받아 스코프가 통째로
# 사라지는데, 모든 요청이 정상 200 이라 관측으로는 절대 드러나지 않는다.
map $remote_user $api_key_for_user {
    default  "${API_AUTH_KEY}";
    reporter "${API_REPORTER_KEY}";
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # 사이트 전체 Basic Auth. server 레벨에 두어 어떤 location 도 새지 않는다.
    # ⚠️ **`auth_basic off;` 를 이 파일 어디에도 쓰지 마라.** 상속을 끊는 한 줄이면
    # (server 레벨이든 새 location 이든) 그 경로가 무자격 200 이 되고, `/api/` 아래면
    # nginx 가 유효 `X-API-Key` 까지 주입하므로 **Phase 2 백엔드 인증도 동시에** 무력화된다
    # (실측: `location = /api/bypass { auth_basic off; }` → 무자격 200). 이 금지는
    # `tests/unit/ast/test_cycle243_deploy_assets.py::D-1` 이 강제한다.
    auth_basic           "auto_stock";
    auth_basic_user_file /etc/nginx/secrets/.htpasswd;

    # ACME(Let's Encrypt) HTTP-01 챌린지 전용 — cycle255 (2026-09-05, TLS 준비 1단계).
    # `/.well-known/acme-challenge/<token>` 은 인증서 발급 중 **무자격 200** 이어야 한다.
    # `auth_basic off;` 는 이 파일에 절대 쓰지 않으므로(D-1-b), 인증 상속을 합법적으로
    # 끊는 유일한 수단이 `satisfy any; allow all;` 다. `^~` 접두는 필수 — 없으면 아래
    # 정적자산 정규식 location 이 먼저 평가될 수 있어 토큰 파일명이 우연히 그 패턴에
    # 걸리는 순간 챌린지가 401 로 떨어져 발급이 실패한다.
    # ⚠️ 이 블록엔 `satisfy`/`allow`/`root`/`default_type` 외 아무 지시어도 두지 마라 —
    # `proxy_pass`/`alias`/`try_files` 가 들어오는 순간 무자격 콘텐츠 제공 경로가 된다
    # (G-247-2 와 동일 논리, 여기선 인증이 명시적으로 꺼져 있어 더 위험하다). `satisfy`
    # 는 이 파일 전체에서 **정확히 1회**만 존재해야 한다(가드 G-255-1).
    # webroot(`/var/www/certbot`)는 호스트 `./certbot-www` 마운트와 짝이다 — 기본
    # compose 에도 같은 마운트가 있어야 첫 발급이 가능하다(TLS 오버레이는 발급 후에만
    # 켜진다).
    location ^~ /.well-known/acme-challenge/ {
        satisfy any;
        allow all;
        root /var/www/certbot;
        default_type text/plain;
    }

    # 브라우저 아이콘 탐침 단락 — cycle247 (2026-09-04).
    # Safari 의 WebKit 네트워킹 프로세스는 favicon / apple-touch-icon 을 페이지 자격 **없이**
    # 따로 가져오고, 그 401 에 실린 WWW-Authenticate 가 **두 번째 로그인 다이얼로그**가 된다
    # (접근 로그 실측: 같은 초에 문서·JS·/api/* 전부 user=ubuntu 200, 아이콘 4경로만
    # user=- 401 → 12초 뒤 같은 경로가 ubuntu 로 재요청 = 재입력). cycle246 의
    # withCredentials 는 Chrome 세션에서 관측된 XHR 무자격 경로만 닫았다.
    # `return` 은 rewrite 단계에서 요청을 끝내 access 단계의 auth_basic 에 **도달하지 않는다**
    # (nginx:alpine 로컬 실측 — `/`·`/assets/*`·`/api/` 는 그대로 401). 그래서 `auth_basic off`
    # 없이 204 를 준다. 204 = 본문 0바이트라 무자격에 노출되는 내용이 없고, 실제 아이콘은
    # index.html 이 data URI 로 품어 서버 요청 자체가 없다.
    # ⚠️ 이 블록들엔 `return 204;` 외에 아무것도 두지 마라 — proxy_pass/root/alias/try_files 가
    # 들어오는 순간 무자격 콘텐츠 제공이 된다(`tests/unit/ast/test_cycle247_*` G-247 가드).
    # 정규식 location 은 **선언 순서**로 매칭되므로 apple-touch 블록은 아래 정적자산 정규식보다
    # 앞에 있어야 한다.
    location = /favicon.ico { return 204; }
    location = /favicon.svg { return 204; }
    location ~ ^/apple-touch-icon(-[0-9]+x[0-9]+)?(-precomposed)?\.png$ { return 204; }

    # API 리버스 프록시
    location /api/ {
        # 방어 심층화 — 상속으로도 걸리지만 명시한다(location 추가 시 누락 방지).
        auth_basic           "auto_stock";
        auth_basic_user_file /etc/nginx/secrets/.htpasswd;

        proxy_pass http://backend:8000;
        # `$host` 는 **포트를 떨어뜨린다** — 80 이외 포트로 들어온 요청(예: SSH 터널
        # `ssh -L 8080:localhost:80`)에서 Host 가 `localhost` 가 되어 백엔드의 상태변경
        # Origin 검사가 `Origin: http://localhost:8080` 과 불일치 → 전부 `cross_origin`
        # 401 이 된다(실측). `$http_host` 는 클라이언트가 보낸 원문 그대로다.
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 백엔드 X-API-Key(Phase 2). 브라우저에는 노출되지 않는다.
        # proxy_set_header 는 클라이언트가 보낸 동명 헤더를 **치환**하므로 헤더 밀반입이
        # 불가능하다(공격자가 직접 보낸 X-API-Key 는 여기서 덮어써진다).
        # cycle249 — 위 `map` 이 고른 사용자별 키(`$api_key_for_user`)를 주입한다.
        proxy_set_header X-API-Key $api_key_for_user;
    }

    # SPA fallback — index.html은 캐시 금지
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # 정적 파일 캐싱 (Vite가 해시 붙임 → 안전하게 장기 캐시)
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
