# cycle255 (2026-09-05) — TLS(443) 서버 블록 템플릿, `auto.dkstock.cloud` 전용.
#
# 이 파일은 **기본 빌드 이미지에 굽지 않는다** — 인증서가 없는 상태로 nginx 가 이 파일을
# 읽으면 `ssl_certificate` 경로 부재로 기동 실패한다. `docker-compose.tls.yml` 오버레이가
# 인증서 발급 **후**에만 이 파일을 `/etc/nginx/templates/tls.conf.template` 로 볼륨
# 마운트해 활성화한다(`.tls_enabled` 마커 기반, `tools/deploy/compose_up_changed.sh`).
#
# ⚠️ 이 파일에 `map` 블록을 두지 마라. `frontend/nginx.conf.template` 의 http 컨텍스트
# `map $remote_user $api_key_for_user { … }` 를 그대로 공유해서 쓴다 — 두 템플릿이 같은
# `/etc/nginx/conf.d/` 아래로 렌더돼 하나의 http 컨텍스트로 합쳐지기 때문이다. 여기서
# 같은 이름을 다시 정의해도 nginx 는 **정상 기동한다**(`nginx -t` 성공, duplicate/emerg 로그
# 0건 — nginx:alpine 실측). 대신 뒤에 include 되는 이 파일(`tls.conf` 가 `default.conf` 뒤)의
# map 이 조용히 이겨 **모든 사용자의 X-API-Key 가 빈 값**이 되고 http/https/reporter 전부
# backend 401 이 된다 — 관측으로 드러나지 않는 실패라 텍스트 가드(G-255-2f)가 유일한 방어다.
#
# ⚠️ 이 파일도 `*.template` 로 envsubst 를 통과한다 — 치환 구문(달러+중괄호)을 어디에도
# 쓰지 마라(cycle246 결함의 재현 경로: 렌더된 설정 주석에 키가 평문으로 박힌다). 인증서
# 경로·Basic Auth·프록시 헤더는 HTTP 템플릿과 값을 그대로 맞춰 하드코딩한다 — 이 파일은
# 변수를 받지 않는다.
#
# 1단계(이 사이클) — 443 을 80 과 **병행** 제공한다. 80 → 443 리다이렉트는 걸지 않는다
# (안정화 뒤 2단계에서 `default.conf.template` 자체를 TLS 전제로 바꾸며 처리). HSTS 도
# 아직 넣지 않는다 — 브라우저에 되돌릴 수 없는 상태를 심으므로, `rm .tls_enabled` 로
# 80 단독 원복 경로가 살아 있어야 하는 지금 단계엔 적합하지 않다.
server {
    listen 443 ssl;
    server_name auto.dkstock.cloud;

    ssl_certificate     /etc/letsencrypt/live/auto.dkstock.cloud/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/auto.dkstock.cloud/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /usr/share/nginx/html;
    index index.html;

    # 사이트 전체 Basic Auth — HTTP 템플릿과 동일 규약. `auth_basic off;` 는 여기에도
    # 절대 쓰지 않는다(D-1-b, TLS 사본에도 그대로 적용된다 — 빠지면 443 만 무인증이 되고
    # 80 은 정상이라 증상이 겉으로 드러나지 않는다).
    auth_basic           "auto_stock";
    auth_basic_user_file /etc/nginx/secrets/.htpasswd;

    # cycle260 — TLS 2단계(HSTS) 준비 스위치, server 레벨. HTTP 템플릿과 같은 마운트 규약
    # (`docker-compose.tls2.yml` 이 있을 때만 존재) — 이 파일 소관은 자체 `add_header` 가
    # 없는 응답(`/api/`·아이콘 204)이다. `location /`·정적자산 location 에는 각자 안에
    # 별도 include 가 있다 — nginx `add_header` 는 상속이 아니라 **대체**라, 하위
    # location 이 자기 add_header 를 하나라도 가지면 상위 것은 그 location 에서
    # 사라진다. 그래서 `tls-srv-*.conf`(여기)와 `tls-loc-*.conf`(location 안)는 **서로
    # 다른 파일 집합**을 열어야 한다 — 같은 파일이 두 곳에서 겹쳐 열리면 같은 HSTS
    # add_header 가 두 번 붙어 값이 `max-age=86400, max-age=86400` 이 되고 브라우저가
    # 헤더를 통째로 무시한다.
    include /etc/nginx/conf.d/stage2/tls-srv-*.conf;

    # 브라우저 아이콘 탐침 단락 — cycle247 과 byte 동일. `return 204;` 외 지시어 금지
    # (proxy_pass/root/alias 가 들어오면 무자격 콘텐츠 제공이 된다). 정규식 location 은
    # 선언 순서로 매칭되므로 이 단락은 아래 정적자산 정규식보다 먼저 있어야 한다.
    location = /favicon.ico { return 204; }
    location = /favicon.svg { return 204; }
    location ~ ^/apple-touch-icon(-[0-9]+x[0-9]+)?(-precomposed)?\.png$ { return 204; }

    # 매크로 API 리버스 프록시 — cycle303, HTTP 템플릿(`frontend/nginx.conf.template`)과
    # byte 동일 규약(변수+resolver·auth_basic 명시·60s 타임아웃·X-API-Key 미전달). 이
    # 파일엔 `map` 을 새로 두지 않는다(아래 설명, G-255-2f) — 이 location 은 애초에
    # `$api_key_for_user` 를 쓰지 않으므로 map 유무와 무관하다.
    location /api/macro/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $macro_upstream http://macro:8000;

        auth_basic           "auto_stock";
        auth_basic_user_file /etc/nginx/secrets/.htpasswd;

        proxy_pass $macro_upstream$request_uri;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 🔴 **120s** — 콜드 캐시 첫 호출 실측이 근거다(2026-09-18 운영):
        #   yield-curve 14.2s · credit-spread 52.4s · **macro-cycle 107.0s** · 환율/원자재 1s 내외.
        # `macro-cycle` 은 5지표를 다 모으느라 60s 로는 **첫 호출이 504** 였다. 그 107초의
        # 대부분은 FRED 가 아니라 **yfinance**(섹터 ETF 11종·버핏지수·공포탐욕)라
        # `MACRO_LITE_FRED_TIMEOUT` 을 더 낮춰도 들어오지 않는다.
        # 같은 날 00:05 KST prewarm(`tools/ops/macro_prewarm.sh`)을 함께 넣어 **사용자가
        # 이 한도에 닿는 일 자체를 없앴고**, 이 값은 그 prewarm 이 실패한 날의 안전망이다.
        proxy_read_timeout 120s;
    }

    # API 리버스 프록시 — HTTP 템플릿과 동일 헤더 4종. `$api_key_for_user` 는 위에서
    # 설명한 대로 HTTP 템플릿의 `map` 을 그대로 공유해서 쓴다(이 파일엔 map 이 없다).
    # ACME 챌린지 location 은 여기 없다 — HTTP-01 은 80 에서만 처리한다(갱신도 동일).
    location /api/ {
        auth_basic           "auto_stock";
        auth_basic_user_file /etc/nginx/secrets/.htpasswd;

        proxy_pass http://backend:8000;
        # `$host` 는 포트를 떨어뜨린다(D-2-b) — 반드시 `$http_host`.
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # 443 에서는 이 값이 비로소 `https` 가 된다 — 리터럴로 굳히지 말 것.
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-API-Key $api_key_for_user;
    }

    # SPA fallback — index.html은 캐시 금지
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        # cycle260 — 이 location 이 자기 `add_header`(Cache-Control)를 갖는 순간 위 server
        # 레벨 HSTS 는 이 응답에서 사라진다(add_header 는 상속이 아니라 대체) — 그래서
        # 문서 응답에 HSTS 를 실으려면 여기서 다시 include 해야 한다.
        include /etc/nginx/conf.d/stage2/tls-loc-*.conf;
    }

    # 정적 파일 캐싱
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        # cycle260 — 위 `location /` 와 같은 이유(대체, 상속 아님) + 같은 글롭(server 것과는
        # 겹치지 않는 파일 집합).
        include /etc/nginx/conf.d/stage2/tls-loc-*.conf;
    }

    # 자체 호스팅 서체 — HTTP 템플릿과 byte 동일 규약(cycle261 후속). `ttf` 가 위 정규식에
    # 없어 no-store SPA fallback 으로 떨어지던 결함을 여기서도 동일하게 시정한다.
    location ^~ /fonts/ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        default_type font/ttf;
    }
}
